<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Phones, tablets, Chromebooks and TVs alike: none of these is needed, so none keeps the app off a device -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.location.network" android:required="false" />

    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Prayer times are alarms: USE_EXACT_ALARM on Android 13+, SCHEDULE_EXACT_ALARM before that -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <!-- The adhan plays from a foreground service so Android doesn't cut it off -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- The app never goes online. The car's player library asks to watch the network; it copes without, so that's taken out -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:description="@string/description"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:enableOnBackInvokedCallback="true"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:banner="@drawable/tv_banner">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings"
            android:launchMode="singleTop" />
        <activity android:name=".LocationActivity"
            android:exported="false"
            android:label="@string/location"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".SetupActivity"
            android:exported="false" />
        <!-- The prayer dial full screen. Open to the launcher's shortcut and to adb, for testing; it only shows
             the dial. Today is its parent, so from the widget or the car Back lands on Today -->
        <activity android:name=".clock.ClockActivity"
            android:exported="true"
            android:parentActivityName=".MainActivity"
            android:theme="@style/ClockTheme">
            <!-- On a TV the app opens straight into the prayer dial -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- "Play the adhan on Adhān Alarm": the dial opens and the adhan plays -->
            <intent-filter>
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- Android Auto: today's prayers on the car's screen, and the adhan through its speakers -->
        <meta-data android:name="com.google.android.gms.car.application" android:resource="@xml/automotive_app_desc" />
        <service android:name=".auto.AutoMediaService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
        <!-- The prayer dial as a screen saver, chosen under Screen saver in the phone's display settings -->
        <service android:name=".clock.PrayerClockDream"
            android:exported="true"
            android:label="@string/prayer_dial"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data android:name="android.service.dream" android:resource="@xml/dream_prayer_clock" />
        </service>
        <!-- Keeps the language chosen in the app on Android 12 and older -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
        <receiver android:name=".widget.TimetableWidgetProvider" android:exported="false" android:label="@string/widget_today">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_timetable" />
        </receiver>
        <receiver android:name=".widget.NextNotificationWidgetProvider" android:exported="false" android:label="@string/widget_next_prayer">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_next_notification" />
        </receiver>
        <receiver android:name=".widget.PrayerDialWidgetProvider" android:exported="false" android:label="@string/prayer_dial">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_dial" />
        </receiver>
        <!-- Direct boot aware, so after a restart the alarm is set and the adhan plays even before the phone is unlocked -->
        <receiver android:name=".receiver.StartNotificationReceiver" android:exported="false" android:directBootAware="true">
            <!-- Anything that can move the next prayer time reschedules the alarm -->
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
            <intent-filter>
                <action android:name="islam.adhanalarm.action.NOTIFY_PRAYER_TIME" />
                <action android:name="islam.adhanalarm.action.NOTIFY_REMINDER" />
                <action android:name="islam.adhanalarm.action.NEW_DAY" />
                <action android:name="islam.adhanalarm.action.PLAY_BISMILLAH" />
            </intent-filter>
        </receiver>
        <receiver android:name=".receiver.HandleNotificationReceiver" android:exported="false" android:directBootAware="true">
            <intent-filter>
                <action android:name="islam.adhanalarm.action.NOTIFICATION_DELETED" />
                <action android:name="islam.adhanalarm.action.NOTIFICATION_STOPPED" />
            </intent-filter>
        </receiver>
        <service
            android:name=".service.AdhanService"
            android:exported="false"
            android:directBootAware="true"
            android:foregroundServiceType="mediaPlayback" />
    </application>
</manifest>
