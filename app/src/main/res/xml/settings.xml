<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory android:title="@string/settings_location">
        <Preference
            android:key="location"
            android:title="@string/location" />
        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="autoLocation"
            android:summary="@string/auto_location_summary"
            android:title="@string/auto_location" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/settings_prayer_times">
        <ListPreference
            android:entries="@array/method_names"
            android:entryValues="@array/method_values"
            android:key="method"
            android:title="@string/method" />
        <ListPreference
            android:defaultValue="standard"
            android:entries="@array/asr_names"
            android:entryValues="@array/asr_values"
            android:key="asr"
            android:title="@string/asr"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            android:defaultValue="seventh"
            android:entries="@array/high_latitude_names"
            android:entryValues="@array/high_latitude_values"
            android:key="highLatitude"
            android:title="@string/high_latitude" />
        <Preference
            android:key="adjustTimes"
            android:title="@string/adjust_times" />
        <ListPreference
            android:defaultValue="0"
            android:entries="@array/hijri_adjust_names"
            android:entryValues="@array/hijri_adjust_values"
            android:key="hijriAdjust"
            android:title="@string/hijri_date_title" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/settings_alerts">
        <Preference
            android:key="prayerAlerts"
            android:title="@string/prayer_alerts" />
        <Preference
            android:key="adhanSound"
            android:title="@string/adhan_sound" />
        <Preference
            android:key="fajrAdhanSound"
            android:title="@string/fajr_adhan_sound" />
        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="shortAdhan"
            android:summary="@string/short_adhan_summary"
            android:title="@string/short_adhan" />
        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="playOnSilent"
            android:summary="@string/play_on_silent_summary"
            android:title="@string/play_on_silent" />
        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="bismillahOnBootUp"
            android:summary="@string/bismillah_summary"
            android:title="@string/bismillah_on_boot_up" />
        <Preference
            android:key="testAdhan"
            android:summary="@string/test_adhan_summary"
            android:title="@string/test_adhan" />
        <Preference
            android:key="alarmCheck"
            android:title="@string/alarm_check" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/settings_display">
        <ListPreference
            android:defaultValue="system"
            android:entries="@array/time_format_names"
            android:entryValues="@array/time_format_values"
            android:key="timeFormat"
            android:title="@string/time_format"
            app:useSimpleSummaryProvider="true" />
        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="arabicNames"
            android:summary="@string/arabic_names_summary"
            android:title="@string/arabic_names" />
        <ListPreference
            android:defaultValue="system"
            android:entries="@array/theme_names"
            android:entryValues="@array/theme_values"
            android:key="theme"
            android:title="@string/theme"
            app:useSimpleSummaryProvider="true" />
        <ListPreference
            android:entries="@array/language_names"
            android:entryValues="@array/language_values"
            android:key="language"
            android:persistent="false"
            android:title="@string/language"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <!-- Folded away behind one "Advanced" row until it's tapped -->
    <PreferenceCategory
        android:key="advanced"
        app:initialExpandedChildrenCount="0">
        <EditTextPreference
            android:defaultValue="0"
            android:key="altitude"
            android:title="@string/altitude" />
        <EditTextPreference
            android:defaultValue="1010"
            android:key="pressure"
            android:title="@string/pressure" />
        <EditTextPreference
            android:defaultValue="10"
            android:key="temperature"
            android:title="@string/temperature" />
        <ListPreference
            android:defaultValue="2"
            android:entries="@array/rounding_names"
            android:entryValues="@array/rounding_values"
            android:key="roundingTypesIndex"
            android:title="@string/rounding" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/settings_about">
        <Preference
            android:key="privacyPolicy"
            android:summary="@string/privacy_summary"
            android:title="@string/privacy_policy" />
        <Preference
            android:key="sourceCode"
            android:summary="@string/source_code_summary"
            android:title="@string/source_code" />
        <Preference
            android:key="credits"
            android:summary="@string/credits_summary"
            android:title="@string/credits" />
        <Preference
            android:key="version"
            android:selectable="false"
            android:title="@string/version" />
    </PreferenceCategory>
</PreferenceScreen>
