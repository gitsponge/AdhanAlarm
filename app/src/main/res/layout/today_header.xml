<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="72dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="56dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/today"
            android:textAppearance="@style/Text.Header.Title" />

        <TextView
            android:id="@+id/today_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/Text.Header.Subtitle" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingBottom="12dp">

        <!-- A long place name is cut short, so the note beside it keeps room to be read -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/location_button"
            style="@style/Widget.Material3.Button.OutlinedButton.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxWidth="240dp"
            android:maxLines="1"
            android:minHeight="48dp"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:icon="@drawable/ic_pin"
            app:iconSize="18dp"
            app:iconTint="?attr/colorOnSurfaceVariant"
            app:strokeColor="?attr/colorOutlineVariant" />

        <TextView
            android:id="@+id/location_note"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:textAppearance="@style/Text.Caption" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/hero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:background="@drawable/hero_background"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingVertical="20dp">

        <TextView
            android:id="@+id/hero_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?attr/colorOnPrimaryContainer" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/hero_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="?attr/colorOnPrimaryContainer"
                android:textSize="32sp" />

            <TextView
                android:id="@+id/hero_arabic"
                style="@style/Text.Arabic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnPrimaryContainer"
                android:textSize="26sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/hero_time"
            style="@style/Text.Time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:letterSpacing="-0.01"
            android:textColor="?attr/colorOnPrimaryContainer"
            android:textSize="48sp" />

        <TextView
            android:id="@+id/hero_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnPrimaryContainer" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/hero_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:importantForAccessibility="no"
            android:max="1000"
            app:indicatorColor="?attr/colorPrimary"
            app:trackColor="@color/progress_track"
            app:trackCornerRadius="4dp"
            app:trackStopIndicatorSize="0dp"
            app:trackThickness="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/hero_from"
                style="@style/Text.Time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/hero_caption"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/hero_to"
                style="@style/Text.Time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/hero_caption"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</merge>
