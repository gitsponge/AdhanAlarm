<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="true"
        android:orientation="horizontal"
        android:paddingBottom="2dp"
        android:paddingHorizontal="10dp">

        <TextView
            android:id="@+id/widget_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/today"
            android:textColor="@color/on_surface"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/widget_hijri"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/on_surface_variant"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/cell0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="7dp">

            <TextView
                android:id="@+id/cell_name0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/fajr"
                android:textColor="@color/past"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/cell_time0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:text="@string/preview_fajr"
                android:textColor="@color/past"
                android:textSize="17sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cell1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="7dp">

            <TextView
                android:id="@+id/cell_name1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/sunrise"
                android:textColor="@color/past"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/cell_time1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:text="@string/preview_sunrise"
                android:textColor="@color/past"
                android:textSize="17sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cell2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="7dp">

            <TextView
                android:id="@+id/cell_name2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/dhuhr"
                android:textColor="@color/past"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/cell_time2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:text="@string/preview_dhuhr"
                android:textColor="@color/past"
                android:textSize="17sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/cell3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="7dp">

            <TextView
                android:id="@+id/cell_name3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/asr"
                android:textColor="@color/past"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/cell_time3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:text="@string/preview_asr"
                android:textColor="@color/past"
                android:textSize="17sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cell4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/widget_cell_next"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="7dp">

            <TextView
                android:id="@+id/cell_name4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/maghrib"
                android:textColor="@color/on_primary_container"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/cell_time4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:text="@string/preview_maghrib"
                android:textColor="@color/on_primary_container"
                android:textSize="17sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cell5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="7dp">

            <TextView
                android:id="@+id/cell_name5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/ishaa"
                android:textColor="@color/on_surface_variant"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/cell_time5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:text="@string/preview_ishaa"
                android:textColor="@color/on_surface"
                android:textSize="17sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
